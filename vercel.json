{
  "builds": [
    { "src": "web/api/index.py", "use": "@vercel/python" },
    { "src": "web/public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "web/api/index.py" },
    { "src": "/briefing", "dest": "web/public/index.html" },
    { "src": "/(.*)", "dest": "web/public/$1" }
  ]
}
