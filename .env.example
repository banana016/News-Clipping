# 이 파일을 .env로 복사한 뒤 실제 값을 채우세요. .env는 절대 커밋하지 마세요.

DRY_RUN=true
TIMEZONE=Asia/Seoul

# --- NAVER API HUB (뉴스 검색) ---
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=

# --- Claude (평가/요약) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=medium

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Kakao Developers ("나에게 보내기") ---
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8000/kakao/callback
# 아래 값은 한 번만 생성하면 됩니다: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KAKAO_TOKEN_ENCRYPTION_KEY=

# --- 이메일 (Gmail SMTP + 앱 비밀번호) ---
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
BRIEFING_RECIPIENT_EMAIL=

# --- 웹앱 / 매직링크 ---
WEB_BASE_URL=https://your-project.vercel.app
# 아래 값은 한 번만 생성하면 됩니다: python -c "import secrets; print(secrets.token_hex(32))"
MAGIC_LINK_SECRET=
MAGIC_LINK_TTL_DAYS=14

# --- 선정 로직 튜닝 (Phase 3에서 확정한 기본값) ---
MIN_SELECT=7
MAX_SELECT=10
MIN_SCORE_THRESHOLD=60
WEIGHT_MIN_SAMPLES=5
WEIGHT_MAX_ADJUSTMENT=5
RESEND_GUARD_DAYS=7
